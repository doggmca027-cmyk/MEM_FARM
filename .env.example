# --- Client (Vite) ---------------------------------------------------------
# Copy to `.env` (gitignored) and fill in. Leave blank to run on mock data.

# Base project URL — NO trailing path. Right:  https://<ref>.supabase.co
#                                     Wrong: https://<ref>.supabase.co/rest/v1/
VITE_SUPABASE_URL=
# anon / public key from Project Settings -> API (safe to expose, RLS-protected)
VITE_SUPABASE_ANON_KEY=
# Telegram bot username without @ (must end in "bot"), builds referral deep links
# https://t.me/<bot>?start=ref_<code>. Defaults to "MemeFarmBot" when unset.
VITE_BOT_USERNAME=
# Treasury hot-wallet address deposits are sent to (in-app Deposit button).
# MUST match the TREASURY_ADDRESS Supabase secret used by ton-deposit-webhook.
VITE_TREASURY_ADDRESS=

# --- Edge Function secrets (server-side only — NEVER put real values here) --
# `.env.example` is committed. Set these with the Supabase CLI instead:
#   supabase secrets set BOT_TOKEN="123456:ABC..."
#   supabase secrets set ADMIN_TELEGRAM_IDS="11111111,22222222"   # admin panel
#   supabase secrets set NOTIFY_SECRET="<random>"                 # notify-dispatcher gate
#   supabase secrets set TMA_URL="https://t.me/<bot>/<app>"       # inline-button link
#   supabase secrets set TREASURY_ADDRESS="EQ..."                 # hot wallet (ton-deposit-webhook self-poll)
#   supabase secrets set TREASURY_WALLET_MNEMONIC="w1 w2 ... w24" # ton-payout-worker signer (v4r2 wallet)
#   supabase secrets set DEPOSIT_WEBHOOK_SECRET="<random>"        # ton-deposit-webhook gate
#   supabase secrets set PAYOUT_WORKER_SECRET="<random>"          # ton-payout-worker gate
#   supabase secrets set TONCENTER_API_KEY="<key>"                # optional, higher rate limit
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are auto-injected
# into the function runtime by Supabase — do not set them manually.
